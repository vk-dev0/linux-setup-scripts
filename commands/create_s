#!/bin/bash

working_dir=""
exec_start=""
description=""
service_name=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -w)
            working_dir="$2"
            shift 2
            ;;
        -e)
            exec_start="$2"
            shift 2
            ;;
        -d)
            description="$2"
            shift 2
            ;;
        -*)
            echo "Unknown option: $1"
            exit 1
            ;;
        *)
            # Save the last non-dash argument as service_name
            service_name="$1"
            shift
            ;;
    esac
done

# Validate required arguments
if [[ -z "$working_dir" || -z "$exec_start" || -z "$description" || -z "$service_name" ]]; then
    echo "Error: Missing required argument."
    echo "Usage: $0 -w <working_dir> -e <exec_start> -d <description> <service_name>"
    exit 1
fi

# Ensure service_name ends with .service
if [[ "$service_name" != *.service ]]; then
    service_name="${service_name}.service"
fi

# Create the systemd service file
sudo cat <<EOF > "/etc/systemd/system/${service_name}"
[Unit]
Description=$description
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=$working_dir
ExecStart=$exec_start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

echo "Service file '/etc/systemd/system/${service_name}' created successfully."
