#!/usr/bin/env bash

set -euo pipefail

usage() {
    echo "Usage: $0 archive.tar.zst|archive.tar.gz [destination]"
    exit 1
}

[[ $# -lt 1 ]] && usage

ARCHIVE="$1"
DEST="${2:-}"

if [[ ! -f "$ARCHIVE" ]]; then
    echo "Error: '$ARCHIVE' does not exist."
    exit 1
fi

case "$ARCHIVE" in
    *.tar.zst|*.tzst)
        FORMAT="zst"
        ;;
    *.tar.gz|*.tgz)
        FORMAT="gz"
        ;;
    *)
        echo "Error: unsupported archive format."
        exit 1
        ;;
esac


if [[ -z "$DEST" ]]; then

    NAME="$(basename "$ARCHIVE")"

    case "$NAME" in
        *.tar.zst)
            DEST="${NAME%.tar.zst}"
            ;;
        *.tzst)
            DEST="${NAME%.tzst}"
            ;;
        *.tar.gz)
            DEST="${NAME%.tar.gz}"
            ;;
        *.tgz)
            DEST="${NAME%.tgz}"
            ;;
    esac

fi


if [[ -e "$DEST" ]]; then
    echo "Error: destination '$DEST' already exists."
    exit 1
fi

mkdir -p "$DEST"

echo "Extracting:"
echo "  Archive: $ARCHIVE"
echo "  Target:  $DEST"


if [[ "$FORMAT" == "zst" ]]; then

    if command -v pv >/dev/null 2>&1; then
        zstd -dc "$ARCHIVE" \
            | pv \
            | tar -xf - -C "$DEST" --strip-components=1
    else
        tar --zstd \
            -xvf "$ARCHIVE" \
            -C "$DEST" \
            --strip-components=1
    fi

else

    if command -v pv >/dev/null 2>&1; then
        gzip -dc "$ARCHIVE" \
            | pv \
            | tar -xf - -C "$DEST" --strip-components=1
    else
        tar -xzvf "$ARCHIVE" \
            -C "$DEST" \
            --strip-components=1
    fi

fi


echo "Done."
