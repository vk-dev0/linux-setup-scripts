#!/bin/bash
set -euo pipefail

URL="${1:-http://localhost:3000}"
shift || true

DEV=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dev)
            DEV=true
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
    shift
done

PROFILE=$(mktemp -d /dev/shm/chromium.XXXXXX)

cleanup() {
    rm -rf -- "$PROFILE"
}

trap cleanup EXIT INT TERM

CHROMIUM_ARGS=(
    --user-data-dir="$PROFILE"

    --no-first-run
    --no-default-browser-check

    --disable-sync
    --disable-background-networking
    --disable-component-update
    --disable-default-apps
    --disable-extensions
    --disable-breakpad
    --disable-crash-reporter

    # Keep Chromium from trying to use unnecessary background features.
    --disable-features=Translate,MediaRouter,OptimizationHints

    # Small temporary caches.
    --disk-cache-size=1048576
    --media-cache-size=1048576
)

if ! $DEV; then
    CHROMIUM_ARGS+=(--kiosk)
fi

exec cage -- chromium \
    "${CHROMIUM_ARGS[@]}" \
    "$URL"
